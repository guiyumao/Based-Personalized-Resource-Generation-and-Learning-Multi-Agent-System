PROJECT_NAME=personalized-learning-system
ENVIRONMENT=development
DEBUG=true

POSTGRES_DB=learning_system
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
# background keeps local HTTP background execution; worker uses the persisted DB queue.
ASSISTANT_TASK_EXECUTION_MODE=background
ASSISTANT_WORKER_HEARTBEAT_SECONDS=5
ASSISTANT_WORKER_STALE_SECONDS=45
ASSISTANT_TASK_MAX_SECONDS=1800
ASSISTANT_CANCEL_WAIT_SECONDS=60
ASSISTANT_SAFE_RETRY_LIMIT=2
ASSISTANT_SAFE_RETRY_BACKOFF_SECONDS=5

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/

NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_SECURE=false
MINIO_BUCKET=learning-assets

ELASTICSEARCH_URL=http://elasticsearch:9200
# Docker Compose uses the shared Chroma server. For an all-local process,
# switch CHROMA_MODE to persistent and use the dedicated knowledge-base index directory.
CHROMA_MODE=http
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
# Chroma 0.5.x serves its API without authentication. Keep this false unless the
# endpoint sits behind an authenticated proxy; the app otherwise refuses to
# connect to any non-loopback, non-private Chroma host.
CHROMA_ALLOW_REMOTE_HOST=false
CHROMA_PERSIST_DIRECTORY=./knowledge_base/index
CHROMA_COLLECTION_NAME=education_resources
CHROMA_COLLECTION_VERSION=v1
KNOWLEDGE_BASE_VERSION=v1
RAG_CORPUS_VERSION=v1
EMBEDDING_MODEL_VERSION=chroma-default-v1
RAG_RETRIEVAL_CONFIG_VERSION=v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_CHUNKER_VERSION=markdown-heading-v2
RAG_RETRIEVAL_TOP_K=5
RAG_FINAL_TOP_K=4
RAG_CACHE_TTL_SECONDS=900
RAG_CACHE_MAX_ENTRIES=512
RAG_LEXICAL_FAST_PATH=true
RAG_LEXICAL_MIN_SCORE=0.35
RAG_INDEX_USE_LLM_TAGS=false
RAG_SCORE_AMBIGUITY_THRESHOLD=0.03
AI_PERFORMANCE_LOG_PATH=./logs/ai-performance.jsonl
USER_SERVICE_URL=http://user-service:8001
AGENT_SERVICE_URL=http://agent-service:8002
RESOURCE_SERVICE_URL=http://resource-service:8003
EVALUATION_SERVICE_URL=http://evaluation-service:8004
TEACHER_SERVICE_URL=http://teacher-service:8005
SYSTEM_SERVICE_URL=http://system-service:8006
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175

JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
PASSWORD_SALT=
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-local-admin-password
DEFAULT_ADMIN_EMAIL=admin@example.com

OPENAI_API_KEY=your-openai-compatible-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Configure either OPENAI_API_KEY or the provider-specific key below.
# DeepSeek/Qwen are OpenAI-compatible and can use their own keys directly.
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Search/Fetch default to https://api.deepseek.com. A reviewed gateway or the
# local recording proxy may override this; such a run must be reported as
# "via gateway", never as an official direct connection.
# DEEPSEEK_SEARCH_BASE=https://api.deepseek.com
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_LIGHT_MODEL=
LLM_PREWARM_ENABLED=true

# Optional image-generation provider (P1-07 图片Provider / 图文编排). The key
# and base URL are deployment-managed and never shown in the administrator UI;
# the UI only records the provider name and model so the capability reports an
# explicit BLOCKED state until this credential is set.
# IMAGE_PROVIDER_API_KEY=
# IMAGE_PROVIDER_BASE_URL=
# IMAGE_PROVIDER_MODEL=
MAX_TOTAL_RETRIES=2
QA_DEADLINE_SECONDS=60
CHAT_DEADLINE_SECONDS=60
EXERCISE_DEADLINE_SECONDS=20
LEARNING_PATH_DEADLINE_SECONDS=30
COURSEWARE_DEADLINE_SECONDS=60
REPORT_DEADLINE_SECONDS=30
RESOURCE_COURSEWARE_VARIANT_COUNT=1
RESOURCE_RAG_TOP_K=5
EXERCISE_CONTEXT_MAX_CHARS=900

# Keep the reverse proxy timeout above the backend AI request budget for SSE.
SSE_PROXY_TIMEOUT_SECONDS=180

# Optional isolation root; unset keeps the existing knowledge_base/corpus.
# KNOWLEDGE_RUNTIME_ROOT=C:/path/to/isolated-runtime
# Backend limits include retries and all descendants of a maintenance task.
KNOWLEDGE_SEARCH_DAY_LIMIT=100
KNOWLEDGE_FETCH_DAY_LIMIT=100
KNOWLEDGE_MODEL_DAY_LIMIT=50
KNOWLEDGE_SEARCH_MONTH_LIMIT=1000
KNOWLEDGE_FETCH_MONTH_LIMIT=1000
KNOWLEDGE_MODEL_MONTH_LIMIT=500
# Configure verified provider rates in millionths of your configured currency.
# No price or zero cost is inferred when rates are absent.
# KNOWLEDGE_COST_CURRENCY=CNY
# KNOWLEDGE_SEARCH_COST_MICROS=
# KNOWLEDGE_FETCH_COST_MICROS=
# KNOWLEDGE_MODEL_COST_MICROS=
# KNOWLEDGE_INPUT_TOKEN_COST_MICROS=
# KNOWLEDGE_OUTPUT_TOKEN_COST_MICROS=
# KNOWLEDGE_TASK_COST_MICROS=
# KNOWLEDGE_DAY_COST_MICROS=
# KNOWLEDGE_MONTH_COST_MICROS=

# Durable model-call ledger; migrate to 0031 before enabling new services.
# Unset limits preserve existing policy; 0 explicitly blocks provider calls.
# These counters use UTC and include failed attempts. No supplier price is inferred.
# AI_PROVIDER_DAY_CALL_LIMIT=100
# AI_PROVIDER_USER_DAY_CALL_LIMIT=20
# AI_PROVIDER_MAX_OUTPUT_TOKENS=2000
# AI_PROVIDER_DAY_OUTPUT_RESERVATION=20000
# Output reservation requires AI_PROVIDER_MAX_OUTPUT_TOKENS on every model client.
# MODEL_USAGE_MODE=LIVE
